---
import { getPage, items, rich, text, type CmsPage } from "../../cms/content";

interface Props {
  page: CmsPage;
}

const { data, edit } = Astro.props.page;
const contactHighlights = items<{ titulo?: string; descripcion?: string }>(data.pasos);
const schedule = items<{ modalidad?: string; horario?: string }>(data.horarios);
const general = await getPage("datos_generales", "general");
const email = text(general.data.email);
---

<section class="contact-section">
  <div class="container contact-wrapper">
    <div class="contact-intro scroll-reveal">
      <ol class="contact-steps" aria-label="Cómo es el proceso" {...edit("pasos")}>
        {
          contactHighlights.map((highlight, index) => (
            <li>
              <span class="serif-accent" aria-hidden="true">{index + 1}</span>
              <div>
                <h2>{text(highlight.titulo)}</h2>
                <p set:html={rich(highlight.descripcion)} />
              </div>
            </li>
          ))
        }
      </ol>

      <div class="contact-details">
        <dl aria-label="Horarios de consulta" {...edit("horarios")}>
          {
            schedule.map((item) => (
              <div>
                <dt>{text(item.modalidad)}</dt>
                <dd>{text(item.horario)}</dd>
              </div>
            ))
          }
        </dl>
        <ul>
          <li><a href={`mailto:${email}`} {...general.edit("email")}>{email}</a></li>
        </ul>
      </div>
    </div>

    <form
        id="formulario"
        class="contact-form scroll-reveal"
        style="--home-reveal-delay: 90ms"
        data-contact-form
        action="/api/contact"
        method="post"
        novalidate
      >
      <div class="contact-honeypot" aria-hidden="true">
        <label for="website">No rellenes este campo</label>
        <input
          id="website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      <div class="form-row">
        <label for="nombre">Nombre y apellidos</label>
        <input
          id="nombre"
          name="nombre"
          type="text"
          autocomplete="name"
          minlength="2"
          required
          aria-describedby="error-nombre"
        />
        <p
          id="error-nombre"
          class="field-error"
          data-error-for="nombre"
          aria-live="assertive"
          aria-atomic="true"
        >
        </p>
      </div>

      <div class="form-row">
        <label for="email">Correo electrónico</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          aria-describedby="error-email"
        />
        <p
          id="error-email"
          class="field-error"
          data-error-for="email"
          aria-live="assertive"
          aria-atomic="true"
        >
        </p>
      </div>

      <div class="form-row">
        <label for="motivo">Motivo de consulta</label>
        <select
          id="motivo"
          name="motivo"
          required
          aria-describedby="error-motivo"
        >
          <option value="">Selecciona una opción</option>
          <option value="hormonal">Salud hormonal y fertilidad en la mujer</option>
          <option value="digestivo">Microbiota y salud digestiva</option>
          <option value="metabolica">Salud metabólica</option>
          <option value="otro">Otro motivo o no lo tengo claro</option>
        </select>
        <p
          id="error-motivo"
          class="field-error"
          data-error-for="motivo"
          aria-live="assertive"
          aria-atomic="true"
        >
        </p>
      </div>

      <div class="form-row">
        <label for="mensaje">Mensaje</label>
        <textarea
          id="mensaje"
          name="mensaje"
          rows="5"
          minlength="20"
          required
          aria-describedby="error-mensaje"></textarea>
        <p
          id="error-mensaje"
          class="field-error"
          data-error-for="mensaje"
          aria-live="assertive"
          aria-atomic="true"
        >
        </p>
      </div>

      <div class="privacy-consent">
        <input
          id="consentimiento"
          name="consentimiento"
          type="checkbox"
          required
          aria-describedby="error-consentimiento"
        />
        <label for="consentimiento">
          He leído la <a href="/politica-privacidad" target="_blank">política de privacidad</a>
        </label>
      </div>

      <details class="privacy-info">
        <summary>Información básica sobre protección de datos</summary>
        <table class="privacy-table">
          <tbody>
            <tr><th scope="row">Finalidad</th><td>Ponernos en contacto con Vd. en relación a su consulta</td></tr>
            <tr><th scope="row">Legitimación</th><td>Relación precontractual con el interesado.</td></tr>
            <tr><th scope="row">Destinatarios</th><td>Responsable de esta web y empresa de hosting</td></tr>
            <tr><th scope="row">Derechos</th><td>Tiene derecho a ejercitar sus derechos de acceso, rectificación, cancelación así como el resto de derechos tal y como se explica en la <a href="/politica-privacidad" target="_blank">política de privacidad</a>.</td></tr>
            <tr><th scope="row">Info adicional</th><td>Puede consultar la información adicional en el apartado “<a href="/politica-privacidad" target="_blank">Política de Privacidad</a>”</td></tr>
          </tbody>
        </table>
      </details>
      <p
        id="error-consentimiento"
        class="field-error"
        data-error-for="consentimiento"
        aria-live="assertive"
        aria-atomic="true"
      >
      </p>

      <button type="submit" class="button" data-submit-button>
        Enviar solicitud
      </button>
      <p
        class="form-status"
        id="contacto-status"
        data-form-status
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
      </p>
      </form>
  </div>
</section>

<script>
  // Astro lo compila y empaqueta (con ?url se publicaba el .ts sin compilar y el navegador no lo ejecutaba)
  import "../../scripts/contact-form.ts";
</script>
