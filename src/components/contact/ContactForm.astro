---
import contactFormScript from "../../scripts/contact-form.ts?url";

const contactHighlights = [
  {
    title: "Valoración individualizada",
    description:
      "Primera consulta de 90 minutos para entender tu caso de forma global.",
  },
  {
    title: "Estrategia propia",
    description:
      "Sin dietas cerradas: una estrategia adaptada a tus necesidades y objetivos.",
  },
  {
    title: "Seguimiento",
    description:
      "Consultas de hasta 60 minutos para valorar tu evolución y ajustar el plan.",
  },
];

const schedule = [
  { mode: "Online", time: "Martes y jueves, de 16:00 a 19:00 h" },
  { mode: "Presencial en Albacete", time: "Miércoles, de 17:30 a 20:30 h" },
];
---

<section class="contact-section">
  <div class="container contact-wrapper">
    <div class="contact-intro scroll-reveal">
      <ol class="contact-steps" aria-label="Cómo es el proceso">
        {
          contactHighlights.map((highlight, index) => (
            <li>
              <span class="serif-accent" aria-hidden="true">{index + 1}</span>
              <div>
                <h2>{highlight.title}</h2>
                <p>{highlight.description}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="contact-details">
        <dl aria-label="Horarios de consulta">
          {
            schedule.map((item) => (
              <div>
                <dt>{item.mode}</dt>
                <dd>{item.time}</dd>
              </div>
            ))
          }
        </dl>
        <ul>
          <li><a href="mailto:hola@maraolivares.com">hola@maraolivares.com</a></li>
          <li><a href="tel:+34600135465">+34 600 135 465</a></li>
        </ul>
      </div>
    </div>

    <form
        id="formulario"
        class="contact-form scroll-reveal"
        style="--home-reveal-delay: 90ms"
        data-contact-form
        action="/api/contact"
        method="post"
        novalidate
      >
      <div class="contact-honeypot" aria-hidden="true">
        <label for="website">No rellenes este campo</label>
        <input
          id="website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      <div class="form-row">
        <label for="nombre">Nombre y apellidos</label>
        <input
          id="nombre"
          name="nombre"
          type="text"
          autocomplete="name"
          minlength="2"
          required
          aria-describedby="error-nombre"
        />
        <p
          id="error-nombre"
          class="field-error"
          data-error-for="nombre"
          aria-live="assertive"
          aria-atomic="true"
        >
        </p>
      </div>

      <div class="form-row">
        <label for="email">Correo electrónico</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          aria-describedby="error-email"
        />
        <p
          id="error-email"
          class="field-error"
          data-error-for="email"
          aria-live="assertive"
          aria-atomic="true"
        >
        </p>
      </div>

      <div class="form-row">
        <label for="motivo">Motivo de consulta</label>
        <select
          id="motivo"
          name="motivo"
          required
          aria-describedby="error-motivo"
        >
          <option value="">Selecciona una opción</option>
          <option value="hormonal">Salud hormonal y fertilidad en la mujer</option>
          <option value="digestivo">Microbiota y salud digestiva</option>
          <option value="metabolica">Salud metabólica</option>
          <option value="otro">Otro motivo o no lo tengo claro</option>
        </select>
        <p
          id="error-motivo"
          class="field-error"
          data-error-for="motivo"
          aria-live="assertive"
          aria-atomic="true"
        >
        </p>
      </div>

      <div class="form-row">
        <label for="mensaje">Mensaje</label>
        <textarea
          id="mensaje"
          name="mensaje"
          rows="5"
          minlength="20"
          required
          aria-describedby="error-mensaje"></textarea>
        <p
          id="error-mensaje"
          class="field-error"
          data-error-for="mensaje"
          aria-live="assertive"
          aria-atomic="true"
        >
        </p>
      </div>

      <div class="form-row form-row--checkbox">
        <input
          id="consentimiento"
          name="consentimiento"
          type="checkbox"
          required
          aria-describedby="error-consentimiento"
        />
        <label for="consentimiento">
          Acepto el tratamiento de mis datos para recibir respuesta a mi
          consulta.
        </label>
      </div>
      <p
        id="error-consentimiento"
        class="field-error"
        data-error-for="consentimiento"
        aria-live="assertive"
        aria-atomic="true"
      >
      </p>

      <button type="submit" class="button" data-submit-button>
        Enviar solicitud
      </button>
      <p
        class="form-status"
        id="contacto-status"
        data-form-status
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
      </p>
      </form>
  </div>
</section>

<script is:inline type="module" src={contactFormScript}></script>
