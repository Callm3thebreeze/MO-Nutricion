---
import { rich, text, type CmsPage } from "../../cms/content";

interface Props {
  /** Página con los campos cta_titulo, cta_texto, cta_boton y cta_boton_2 */
  page: CmsPage;
  href?: string;
  secondaryHref?: string;
  spaced?: boolean;
}

const { page, href = "/contacto", secondaryHref, spaced = false } = Astro.props;
const { data, edit } = page;
const secondaryLabel = text(data.cta_boton_2);
---

<section class={`pages-cta ${spaced ? "pages-cta--spaced" : ""}`}>
  <div class="container">
    <div class="cta-panel cta-panel--compact scroll-reveal">
      <h2 {...edit("cta_titulo")} set:html={rich(data.cta_titulo)} />
      {text(data.cta_texto) && <p {...edit("cta_texto")} set:html={rich(data.cta_texto)} />}
      <div class="button-row">
        <a class="button" href={href} {...edit("cta_boton")}>{text(data.cta_boton)}</a>
        {
          secondaryHref && secondaryLabel && (
            <a class="button button--secondary" href={secondaryHref} {...edit("cta_boton_2")}>
              {secondaryLabel}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
