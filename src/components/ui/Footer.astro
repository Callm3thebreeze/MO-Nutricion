---
import mainLogo from "../../assets/logo/simple-logo.webp";
import { getPage, text } from "../../cms/content";

const { data, edit } = await getPage("datos_generales", "general");
const email = text(data.email);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a
        class="site-footer__logo"
        href="/"
        aria-label="Mara Olivares Nutrición Integrativa, ir al inicio"
      >
        <img
          src={mainLogo.src}
          width={mainLogo.width}
          height={mainLogo.height}
          alt="Logotipo de Mara Olivares Nutrición Integrativa"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p>
        Colegiada <span {...edit("colegiada")}>{text(data.colegiada)}</span>.
      </p>
    </div>

    <div class="site-footer__column">
      <h2>Contacto</h2>
      <ul class="site-footer__list">
        <li><a href={`mailto:${email}`} {...edit("email")}>{email}</a></li>
      </ul>
    </div>

    <div class="site-footer__column">
      <h2>Horarios</h2>
      <ul class="site-footer__list">
        <li {...edit("pie_online")}>{text(data.pie_online)}</li>
        <li {...edit("pie_presencial")}>{text(data.pie_presencial)}</li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p>© {new Date().getFullYear()} Mara Olivares – Nutrición Integrativa · <a href="/preguntas-frecuentes">Preguntas frecuentes</a></p>
    <p {...edit("pie_legal")}>{text(data.pie_legal)}</p>
  </div>
</footer>
