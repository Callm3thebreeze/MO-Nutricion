---
import mainLogo from "../../assets/logo/simple-logo.png";
import { getPage, rich, text } from "../../cms/content";

const { data, edit } = await getPage("datos_generales", "general");
const email = text(data.email);
const phone = text(data.telefono);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a
        class="site-footer__logo"
        href="/"
        aria-label="Mara Olivares Nutrición Integrativa, ir al inicio"
      >
        <img
          src={mainLogo.src}
          width={mainLogo.width}
          height={mainLogo.height}
          alt="Logotipo de Mara Olivares Nutrición Integrativa"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p {...edit("pie_areas")} set:html={rich(data.pie_areas)} />
      <p>
        <span {...edit("pie_modalidad")} set:html={rich(data.pie_modalidad)} /><br />
        Colegiada <span {...edit("colegiada")}>{text(data.colegiada)}</span>.
      </p>
    </div>

    <nav class="site-footer__column" aria-label="Navegación del pie">
      <h2>Navegación</h2>
      <ul class="site-footer__list">
        <li><a href="/">Inicio</a></li>
        <li><a href="/sobre-mi">Sobre mí</a></li>
        <li><a href="/servicios">Áreas de especialización</a></li>
        <li><a href="/como-trabajo">Cómo trabajo</a></li>
        <li><a href="/consultas">Consultas y tarifas</a></li>
        <li><a href="/preguntas-frecuentes">Preguntas frecuentes</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
    </nav>

    <div class="site-footer__column">
      <h2>Contacto</h2>
      <ul class="site-footer__list">
        <li><a href={`mailto:${email}`} {...edit("email")}>{email}</a></li>
        <li><a href={`tel:${phone.replace(/[^+\d]/g, "")}`} {...edit("telefono")}>{phone}</a></li>
        <li {...edit("pie_online")}>{text(data.pie_online)}</li>
        <li {...edit("pie_presencial")}>{text(data.pie_presencial)}</li>
      </ul>
    </div>

    <div class="site-footer__column">
      <h2 {...edit("pie_cta_titulo")}>{text(data.pie_cta_titulo)}</h2>
      <a class="button button--secondary" href="/contacto" {...edit("pie_cta_boton")}>{text(data.pie_cta_boton)}</a>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p>© {new Date().getFullYear()} Mara Olivares – Nutrición Integrativa</p>
    <p {...edit("pie_legal")}>{text(data.pie_legal)}</p>
  </div>
</footer>
