---
import { areas } from "../../lib/content";
---

<section class="home-services" id="areas">
  <div class="container">
    <div class="heading-row home-reveal">
      <h2 class="display-title">Áreas de <span class="serif-accent">especialización</span></h2>
      <p class="heading-row__text home-services__intro">
        La nutrición interviene en numerosos procesos del organismo. Por eso,
        cada consulta comienza por comprender qué necesitas y cuáles son los
        factores que pueden estar influyendo en tu salud. Mi trabajo se centra
        en tres áreas principales.
      </p>
    </div>

    <ul class="service-index">
      {
        areas.map((area, index) => (
          <li class="home-reveal" style={`--home-reveal-delay: ${index * 60}ms`}>
            <a class="service-index__row" href={`/servicios/${area.slug}`}>
              <span class="service-index__number serif-accent">0{index + 1}</span>
              <span class="service-index__main">
                <span class="service-index__title">{area.title}</span>
                {area.summary.map((paragraph) => (
                  <span class="service-index__description">{paragraph}</span>
                ))}
                {area.forEveryone && (
                  <span class="service-index__audience">Para hombres y mujeres</span>
                )}
                <span class="service-index__cta">Descubre esta área</span>
              </span>
              <span class="service-index__topics">
                {area.highlights.map((topic) => (
                  <span>{topic}</span>
                ))}
                <span class="service-index__more">entre otros motivos de consulta</span>
              </span>
              <span class="service-index__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
