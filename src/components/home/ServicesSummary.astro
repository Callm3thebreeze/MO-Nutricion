---
import { lines, paragraphs, rich, text, type CmsArea, type CmsPage } from "../../cms/content";

interface Props {
  page: CmsPage;
  areas: CmsArea[];
}

const { page, areas } = Astro.props;
const { data, edit } = page;
---

<section class="home-services" id="areas">
  <div class="container">
    <div class="heading-row home-reveal">
      <h2 class="display-title" {...edit("areas_titulo")} set:html={rich(data.areas_titulo)} />
      <p class="heading-row__text home-services__intro" {...edit("areas_texto")} set:html={rich(data.areas_texto)} />
    </div>

    <ul class="service-index">
      {
        areas.map((area, index) => (
          <li class="home-reveal" style={`--home-reveal-delay: ${index * 60}ms`}>
            <a class="service-index__row" href={`/servicios/${area.slug}`}>
              <span class="service-index__number serif-accent">{String(index + 1).padStart(2, "0")}</span>
              <span class="service-index__main">
                <span class="service-index__title" {...area.edit("titulo")}>{text(area.data.titulo)}</span>
                {paragraphs(area.data.resumen).map((paragraph) => (
                  <span class="service-index__description" set:html={rich(paragraph)} />
                ))}
                {area.data.para_todos && (
                  <span class="service-index__audience">{text(data.areas_publico)}</span>
                )}
                <span class="service-index__cta">{text(data.areas_enlace)}</span>
              </span>
              <span class="service-index__topics">
                {lines(area.data.motivos).map((topic) => (
                  <span>{topic}</span>
                ))}
                <span class="service-index__more">{text(data.areas_mas)}</span>
              </span>
              <span class="service-index__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
