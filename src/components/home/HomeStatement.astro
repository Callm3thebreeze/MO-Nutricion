---
import { paragraphs, rich, text, type CmsPage } from "../../cms/content";

interface Props {
  page: CmsPage;
}

const { data, edit } = Astro.props.page;
---

<section class="home-statement">
  <div class="container home-statement__inner home-reveal">
    <h2 class="home-statement__meta" {...edit("enfoque_etiqueta")}>{text(data.enfoque_etiqueta)}</h2>
    <div class="home-statement__body">
      <p class="home-statement__text" {...edit("enfoque_titulo")} set:html={rich(data.enfoque_titulo)} />
      <div class="home-statement__columns" {...edit("enfoque_texto")}>
        {paragraphs(data.enfoque_texto).map((paragraph) => <p set:html={rich(paragraph)} />)}
      </div>
    </div>
  </div>
</section>
