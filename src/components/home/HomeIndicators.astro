---
import { items, rich, text, type CmsPage } from "../../cms/content";

interface Props {
  page: CmsPage;
}

const { data, edit } = Astro.props.page;
const indicators = items<{ titulo?: string; descripcion?: string }>(data.indicadores);
---

<section class="home-values">
  <div class="container home-values__inner">
    <div class="heading-row home-reveal">
      <h2 class="display-title" {...edit("indicadores_titulo")} set:html={rich(data.indicadores_titulo)} />
      <p class="heading-row__text" {...edit("indicadores_texto")} set:html={rich(data.indicadores_texto)} />
    </div>
    <ul class="values-grid" {...edit("indicadores")}>
      {
        indicators.map((indicator, index) => (
          <li
            class="values-grid__item home-reveal"
            style={`--home-reveal-delay: ${(index % 3) * 80}ms`}
          >
            <h3>{text(indicator.titulo)}</h3>
            <p set:html={rich(indicator.descripcion)} />
          </li>
        ))
      }
    </ul>
    <p class="home-values__closing home-reveal" {...edit("indicadores_cierre")} set:html={rich(data.indicadores_cierre)} />
  </div>
</section>
