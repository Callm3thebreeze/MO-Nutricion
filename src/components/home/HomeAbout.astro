---
import portraitImage from "../../assets/home/mara-halftone.png";
import { paragraphs, rich, text, type CmsPage } from "../../cms/content";

interface Props {
  page: CmsPage;
}

const { data, edit } = Astro.props.page;
---

<section class="home-about" id="sobre-mi">
  <div class="home-about__media">
    <img
      src={portraitImage.src}
      width={portraitImage.width}
      height={portraitImage.height}
      alt="Mara Olivares, dietista-nutricionista"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="home-about__copy home-reveal">
    <p class="home-about__label" {...edit("sobre_mi_etiqueta")}>{text(data.sobre_mi_etiqueta)}</p>
    <h2
      class="display-title display-title--strong"
      {...edit("sobre_mi_titulo")}
      set:html={rich(data.sobre_mi_titulo)}
    />
    <p class="home-about__lead" {...edit("sobre_mi_subtitulo")} set:html={rich(data.sobre_mi_subtitulo)} />
    <div class="home-about__text" {...edit("sobre_mi_texto")}>
      {paragraphs(data.sobre_mi_texto).map((paragraph) => <p set:html={rich(paragraph)} />)}
    </div>

    <a class="button" href="/sobre-mi" {...edit("sobre_mi_boton")}>{text(data.sobre_mi_boton)}</a>
  </div>
</section>
