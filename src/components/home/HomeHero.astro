---
import eggsImage from "../../assets/eggs.webp";
import pomegranateImage from "../../assets/granade.webp";
import orangeImage from "../../assets/orange.webp";
import asparagusImage from "../../assets/sparagus.webp";
import tomatoesImage from "../../assets/tomatoes.webp";
import { rich, text, type CmsPage } from "../../cms/content";
import CheckerCells from "../ui/CheckerCells.astro";

interface Props {
  page: CmsPage;
}

const { data, edit } = Astro.props.page;

// cada visita muestra una imagen al azar, con más probabilidad cuanto mayor es su peso.
// El sorteo se hace en el navegador porque el HTML se cachea en el borde (src/middleware.ts).
// Las composiciones apaisadas se muestran algo más grandes.
const heroImages = [
  { image: tomatoesImage, alt: "Tomates en rama con efecto halftone", weight: 3 },
  { image: pomegranateImage, alt: "Granada abierta y calabaza con efecto halftone", weight: 3 },
  { image: asparagusImage, alt: "Manojo de espárragos y huevo con efecto halftone", weight: 2, wide: true },
  { image: orangeImage, alt: "Naranja y alcachofa con efecto halftone", weight: 2, wide: true },
  { image: eggsImage, alt: "Huevos fritos con efecto halftone", weight: 1 },
];

const heroOptions = heroImages.map(({ image, alt, weight, wide }) => ({
  src: image.src,
  width: image.width,
  height: image.height,
  alt,
  weight,
  wide: Boolean(wide),
}));
const fallback = heroImages[0];
---

<section class="home-hero" id="inicio">
  <div class="home-hero__copy" data-hero-copy>
    <h1
      class="home-hero__title"
      data-split-title
      {...edit("hero_titulo")}
      set:html={rich(data.hero_titulo, { lightClass: "home-hero__title-light", lastAccentClass: "home-hero__mark" })}
    />
    <p class="home-hero__lead" {...edit("hero_subtitulo")} set:html={rich(data.hero_subtitulo)} />
    <div class="home-hero__actions">
      <a class="button" href="/como-trabajo" {...edit("hero_boton_1")}>{text(data.hero_boton_1)}</a>
      <a class="button button--secondary" href="/contacto" {...edit("hero_boton_2")}>{text(data.hero_boton_2)}</a>
    </div>
  </div>

  <div class="home-hero__visual" data-hero-visual>
    <CheckerCells />
    <img
      class="home-hero__image"
      data-speed="0.88"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <script is:inline define:vars={{ heroOptions }}>
      const img = document.currentScript.previousElementSibling;
      let ticket = Math.random() * heroOptions.reduce((total, item) => total + item.weight, 0);
      const hero = heroOptions.find((item) => (ticket -= item.weight) < 0) ?? heroOptions[0];
      img.width = hero.width;
      img.height = hero.height;
      img.alt = hero.alt;
      img.classList.toggle("home-hero__image--wide", hero.wide);
      img.src = hero.src;
    </script>
    <noscript>
      <img
        src={fallback.image.src}
        width={fallback.image.width}
        height={fallback.image.height}
        alt={fallback.alt}
        class="home-hero__image"
      />
    </noscript>
  </div>
</section>
