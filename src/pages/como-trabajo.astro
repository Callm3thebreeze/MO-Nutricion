---
import PageCta from "../components/ui/PageCta.astro";
import PageHero from "../components/ui/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPage, items, lines, paragraphs, plain, rich, text } from "../cms/content";
import "../styles/components/pages.css";

const page = await getPage("pagina_como_trabajo", "como-trabajo");
const { data, edit } = page;
const phases = items<{ titulo?: string; frase?: string; duracion?: string; texto?: string }>(data.fases);
---

<BaseLayout
  title={plain(data.meta_titulo)}
  description={plain(data.meta_descripcion)}
  canonicalPath="/como-trabajo"
  mainClass="pages-main"
>
  <PageHero>
    <p class="page-label" {...edit("hero_etiqueta")}>{text(data.hero_etiqueta)}</p>
    <h1 class="page-title" {...edit("hero_titulo")} set:html={rich(data.hero_titulo)} />
    <p class="page-hero__lead" {...edit("hero_subtitulo")} set:html={rich(data.hero_subtitulo)} />
    <p class="page-hero__text" {...edit("hero_texto")} set:html={rich(data.hero_texto)} />
  </PageHero>

  <section class="method pages-section">
    <div class="container">
      <ol class="phase-list" {...edit("fases")}>
        {
          phases.map((phase, index) => (
            <li class="phase scroll-reveal">
              <div class="phase__header">
                <span class="phase__number serif-accent" aria-hidden="true">{index + 1}</span>
                <p class="page-label">{text(data.fase_etiqueta)} {index + 1}</p>
                <h2>{text(phase.titulo)}</h2>
                {text(phase.duracion) && <span class="phase__duration">{text(phase.duracion)}</span>}
              </div>
              <div class="phase__body">
                <p class="phase__lead serif-accent">{text(phase.frase)}</p>
                {paragraphs(phase.texto).map((paragraph) => <p set:html={rich(paragraph)} />)}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="split-section split-section--cream">
    <div class="container split-section__inner scroll-reveal">
      <h2 class="split-section__label" {...edit("valoramos_titulo")}>{text(data.valoramos_titulo)}</h2>
      <div class="split-section__body">
        <ul class="ruled-list assessment-list" {...edit("valoramos")}>
          {lines(data.valoramos).map((item) => <li set:html={rich(item)} />)}
        </ul>
      </div>
    </div>
  </section>

  <section class="area-closing">
    <div class="container area-closing__inner scroll-reveal">
      <p class="area-closing__text" {...edit("cierre_texto")} set:html={rich(data.cierre_texto)} />
    </div>
  </section>

  <PageCta page={page} secondaryHref="/consultas" />
</BaseLayout>
