---
import PageCta from "../components/ui/PageCta.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { methodPhases, processAssessment } from "../lib/content";
import "../styles/components/pages.css";
---

<BaseLayout
  title="Cómo trabajo"
  description="Un proceso individualizado, no una dieta estándar: valoración inicial, estrategia nutricional personalizada, seguimiento y consolidación de hábitos."
  canonicalPath="/como-trabajo"
  mainClass="pages-main"
>
  <section class="page-intro">
    <div class="container page-intro__inner">
      <div class="page-intro__heading">
        <p class="page-label">Cómo trabajo</p>
        <h1 class="page-title">
          Un proceso individualizado, <span class="serif-accent">no una dieta estándar</span>
        </h1>
      </div>
      <div class="page-intro__text">
        <p>Cada consulta comienza por conocer tu situación y comprender qué necesitas.</p>
        <p>
          No trabajo con menús cerrados ni con protocolos universales. Mi
          metodología parte de una valoración individualizada y se desarrolla
          mediante una estrategia nutricional que se adapta a tu evolución.
        </p>
      </div>
    </div>
  </section>

  <section class="method">
    <div class="container">
      <ol class="phase-list">
        {
          methodPhases.map((phase, index) => (
            <li class="phase scroll-reveal">
              <div class="phase__header">
                <span class="phase__number serif-accent" aria-hidden="true">{index + 1}</span>
                <p class="page-label">Fase {index + 1}</p>
                <h2>{phase.title}</h2>
                {phase.duration && <span class="phase__duration">{phase.duration}</span>}
              </div>
              <div class="phase__body">
                <p class="phase__lead serif-accent">{phase.lead}</p>
                {phase.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="split-section split-section--cream">
    <div class="container split-section__inner scroll-reveal">
      <h2 class="split-section__label">Qué valoramos durante el proceso</h2>
      <div class="split-section__body">
        <ul class="ruled-list assessment-list">
          {processAssessment.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="area-closing">
    <div class="container area-closing__inner scroll-reveal">
      <p class="area-closing__text">
        Una buena estrategia nutricional no es la que más restricciones impone,
        sino la que <span class="serif-accent">responde a tus necesidades</span>
        y puedes mantener en el tiempo.
      </p>
    </div>
  </section>

  <PageCta
    text="La primera consulta dura 90 minutos y se puede realizar online o de forma presencial en Albacete."
    label="Reserva tu consulta"
    secondaryHref="/consultas"
    secondaryLabel="Consultas y tarifas"
  >
    Empecemos por la <span class="serif-accent">valoración inicial</span>
  </PageCta>
</BaseLayout>
