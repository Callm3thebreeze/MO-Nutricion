---
import PageCta from "../components/ui/PageCta.astro";
import PageHero from "../components/ui/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPage, items, lines, plain, rich, text } from "../cms/content";
import { feesGraph } from "../lib/schema";
import "../styles/components/pages.css";

const page = await getPage("pagina_consultas", "consultas");
const { data, edit } = page;

interface Fee {
  titulo?: string;
  precio?: string;
  detalle?: string;
  descripcion?: string;
  incluye?: string;
  nota?: string;
  destacada?: boolean;
}

const fees = items<Fee>(data.tarifas);
const feesLd = feesGraph(
  Astro.site,
  fees.map((fee) => ({ name: plain(fee.titulo), price: plain(fee.precio), description: plain(fee.detalle) })),
);
const modalities = items<{ modalidad?: string; dias?: string; horario?: string; descripcion?: string }>(
  data.modalidades,
);
---

<BaseLayout
  title={plain(data.meta_titulo)}
  description={plain(data.meta_descripcion)}
  canonicalPath="/consultas"
  mainClass="pages-main"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(feesLd)} />
  <PageHero>
    <p class="page-label" {...edit("hero_etiqueta")}>{text(data.hero_etiqueta)}</p>
    <h1 class="page-title" {...edit("hero_titulo")} set:html={rich(data.hero_titulo)} />
    <p class="page-hero__lead" {...edit("hero_subtitulo")} set:html={rich(data.hero_subtitulo)} />
  </PageHero>

  <section class="fees pages-section">
    <div class="container">
      <ul class="fee-list" {...edit("tarifas")}>
        {
          fees.map((item, index) => (
            <li
              class={`fee-card scroll-reveal ${item.destacada ? "fee-card--featured" : ""}`}
              style={`--home-reveal-delay: ${index * 80}ms`}
            >
              <h2>{text(item.titulo)}</h2>
              <p class="fee-card__price">{text(item.precio)}</p>
              <p class="fee-card__detail">{text(item.detalle)}</p>
              <p class="fee-card__description" set:html={rich(item.descripcion)} />
              <h3>{text(data.incluye_titulo)}</h3>
              <ul class="ruled-list">
                {lines(item.incluye).map((line) => <li set:html={rich(line)} />)}
              </ul>
              {text(item.nota) && <p class="fee-card__note">{text(item.nota)}</p>}
            </li>
          ))
        }
      </ul>
      <div class="fee-conditions scroll-reveal" {...edit("condiciones")}>
        <strong>{text(data.condiciones_titulo)}</strong>
        {lines(data.condiciones).map((condition) => <span set:html={rich(condition)} />)}
      </div>
    </div>
  </section>

  <section class="split-section split-section--cream" style="margin-top: var(--page-space)">
    <div class="container split-section__inner scroll-reveal">
      <h2 class="split-section__label" {...edit("modalidades_titulo")}>{text(data.modalidades_titulo)}</h2>
      <div class="split-section__body">
        <div class="modality-grid" {...edit("modalidades")}>
          {
            modalities.map((item) => (
              <div class="modality">
                <h3>{text(item.modalidad)}</h3>
                <p class="modality__time">
                  {text(item.dias)} · {text(item.horario)}
                </p>
                <p set:html={rich(item.descripcion)} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <PageCta spaced page={page} secondaryHref="/preguntas-frecuentes" />
</BaseLayout>
