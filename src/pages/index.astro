---
import HomeAbout from '../components/home/HomeAbout.astro';
import HomeCta from '../components/home/HomeCta.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeIntro from '../components/home/HomeIntro.astro';
import HomeIndicators from '../components/home/HomeIndicators.astro';
import HomeStatement from '../components/home/HomeStatement.astro';
import ServicesSummary from '../components/home/ServicesSummary.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAreas, getPage, plain } from '../cms/content';
import '../styles/components/home.css';

const page = await getPage('pagina_inicio', 'inicio');
const areas = await getAreas();
---

<BaseLayout
title={plain(page.data.meta_titulo)}
description={plain(page.data.meta_descripcion)}
canonicalPath="/"
mainClass="home-main"
>
	<HomeHero page={page} />
	<HomeIntro page={page} />
	<ServicesSummary page={page} areas={areas} />
	<HomeStatement page={page} />
	<HomeIndicators page={page} />
	<HomeAbout page={page} />
	<HomeCta page={page} />
</BaseLayout>
