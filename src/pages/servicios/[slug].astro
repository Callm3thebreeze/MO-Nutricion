---
import PageHero from "../../components/ui/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAreas, getPage, items, paragraphs, plain, rich, text } from "../../cms/content";
import "../../styles/components/pages.css";

const areas = await getAreas();
const index = areas.findIndex((item) => item.slug === Astro.params.slug);

if (index === -1) {
  return Astro.rewrite("/404");
}

const { data: labels, edit: editLabels } = await getPage("pagina_areas", "areas");
const { data, edit } = areas[index];
const number = (position: number) => String(position + 1).padStart(2, "0");

const [lead, ...approach] = paragraphs(data.introduccion);
const [extraStatement, ...extraParagraphs] = paragraphs(data.extra_texto);
const topics = items<{ titulo?: string; descripcion?: string }>(data.temas);

const otherAreas = areas
  .map((item, position) => ({ ...item, position }))
  .filter((item) => item.slug !== areas[index].slug);
---

<BaseLayout
  title={plain(data.titulo)}
  description={paragraphs(data.resumen).map(plain).join(" ")}
  canonicalPath={`/servicios/${areas[index].slug}`}
  mainClass="pages-main"
>
  <PageHero>
    <a class="link-arrow link-arrow--back" href="/servicios">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg>
      {text(labels.detalle_volver)}
    </a>
    <p class="page-label">{text(labels.detalle_etiqueta)} {number(index)}</p>
    <h1 class="page-title" {...edit("titulo")}>{text(data.titulo)}</h1>
    {lead && <p class="page-hero__lead" {...edit("introduccion")} set:html={rich(lead)} />}
    {Boolean(data.para_todos) && (
      <span class="audience-tag" {...editLabels("detalle_publico")}>{text(labels.detalle_publico)}</span>
    )}
  </PageHero>

  {
    approach.length > 0 && (
      <section class="split-section">
        <div class="container split-section__inner scroll-reveal">
          <h2 class="split-section__label" {...editLabels("detalle_enfoque_titulo")}>
            {text(labels.detalle_enfoque_titulo)}
          </h2>
          <div class="split-section__body">
            <div class="text-columns" {...edit("introduccion")}>
              {approach.map((paragraph) => <p set:html={rich(paragraph)} />)}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="split-section">
    <div class="container split-section__inner">
      <h2 class="split-section__label scroll-reveal" {...editLabels("detalle_temas_titulo")}>
        {text(labels.detalle_temas_titulo)}
      </h2>
      <div class="split-section__body">
        <ul class="topic-grid" {...edit("temas")}>
          {
            topics.map((topic, topicIndex) => (
              <li
                class="topic-grid__item scroll-reveal"
                style={`--home-reveal-delay: ${(topicIndex % 2) * 80}ms`}
              >
                <span class="topic-grid__number serif-accent" aria-hidden="true">
                  {number(topicIndex)}
                </span>
                <h3>{text(topic.titulo)}</h3>
                <p set:html={rich(topic.descripcion)} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    text(data.extra_titulo) && (
      <section class="split-section split-section--cream">
        <div class="container split-section__inner scroll-reveal">
          <h2 class="split-section__label" {...edit("extra_titulo")}>{text(data.extra_titulo)}</h2>
          <div class="split-section__body" {...edit("extra_texto")}>
            {extraStatement && <p class="split-section__statement" set:html={rich(extraStatement)} />}
            <div class="text-columns">
              {extraParagraphs.map((paragraph) => <p set:html={rich(paragraph)} />)}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="area-closing">
    <div class="container area-closing__inner scroll-reveal">
      <p class="area-closing__text" {...edit("cierre")} set:html={rich(data.cierre)} />
      <a class="button" href="/contacto" {...editLabels("detalle_boton")}>{text(labels.detalle_boton)}</a>
    </div>
  </section>

  <nav class="area-nav" aria-label="Otras áreas de especialización">
    <div class="container">
      <ul class="area-nav__list">
        {
          otherAreas.map((item) => (
            <li>
              <a href={`/servicios/${item.slug}`}>
                <span class="page-label">{text(labels.detalle_etiqueta)} {number(item.position)}</span>
                <strong>{text(item.data.titulo)}</strong>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</BaseLayout>
