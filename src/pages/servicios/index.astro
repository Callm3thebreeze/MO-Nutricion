---
import PageCta from "../../components/ui/PageCta.astro";
import PageHero from "../../components/ui/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAreas, getPage, lines, paragraphs, plain, rich, text } from "../../cms/content";
import "../../styles/components/pages.css";

const page = await getPage("pagina_areas", "areas");
const { data, edit } = page;
const areas = await getAreas();
const number = (index: number) => String(index + 1).padStart(2, "0");
---

<BaseLayout
  title={plain(data.meta_titulo)}
  description={plain(data.meta_descripcion)}
  canonicalPath="/servicios"
  mainClass="pages-main"
>
  <PageHero>
    <p class="page-label" {...edit("hero_etiqueta")}>{text(data.hero_etiqueta)}</p>
    <h1 class="page-title" {...edit("hero_titulo")} set:html={rich(data.hero_titulo)} />
    <p class="page-hero__lead" {...edit("hero_subtitulo")} set:html={rich(data.hero_subtitulo)} />

    <div class="areas-venn" slot="visual" aria-hidden="true">
      <span class="areas-venn__circle"></span>
      <span class="areas-venn__circle"></span>
      <span class="areas-venn__circle"></span>
    </div>
  </PageHero>

  <section class="services-areas">
    <div class="container">
      <ul class="area-list">
        {
          areas.map((area, index) => (
            <li id={area.slug} class="area-list__item scroll-reveal">
              <span class="area-list__number serif-accent" aria-hidden="true">{number(index)}</span>
              <div class="area-list__main">
                <h2 {...area.edit("titulo")}>
                  <a href={`/servicios/${area.slug}`}>{text(area.data.titulo)}</a>
                </h2>
                <div {...area.edit("resumen")}>
                  {paragraphs(area.data.resumen).map((paragraph) => <p set:html={rich(paragraph)} />)}
                </div>
                {Boolean(area.data.para_todos) && <span class="audience-tag">{text(data.publico_texto)}</span>}
                <a class="link-arrow" href={`/servicios/${area.slug}`}>
                  {text(data.enlace_texto)}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </a>
              </div>
              <div class="area-list__topics">
                <h3 {...edit("motivos_titulo")}>{text(data.motivos_titulo)}</h3>
                <ul class="ruled-list" {...area.edit("motivos")}>
                  {lines(area.data.motivos).map((topic) => <li set:html={rich(topic)} />)}
                  <li>{text(data.motivos_cierre)}</li>
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <PageCta spaced page={page} />
</BaseLayout>
