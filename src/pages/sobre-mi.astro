---
import portraitImage from "../assets/home/mara-halftone.webp";
import PageCta from "../components/ui/PageCta.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPage, lines, paragraphs, plain, rich, text } from "../cms/content";
import "../styles/components/pages.css";

const page = await getPage("pagina_sobre_mi", "sobre-mi");
const { data, edit } = page;
---

<BaseLayout
  title={plain(data.meta_titulo)}
  description={plain(data.meta_descripcion)}
  canonicalPath="/sobre-mi"
  mainClass="pages-main"
>
  <section class="about-hero">
    <div class="about-hero__copy" data-hero-copy>
      <p class="page-label" {...edit("hero_etiqueta")}>{text(data.hero_etiqueta)}</p>
      <h1 class="page-title" {...edit("hero_titulo")} set:html={rich(data.hero_titulo)} />
      <p class="about-hero__subtitle" {...edit("hero_subtitulo")} set:html={rich(data.hero_subtitulo)} />
      <div class="about-hero__text" {...edit("hero_texto")}>
        {paragraphs(data.hero_texto).map((paragraph) => <p set:html={rich(paragraph)} />)}
      </div>
    </div>
    <div class="about-hero__media" data-hero-visual="photo">
      <img
        src={portraitImage.src}
        width={portraitImage.width}
        height={portraitImage.height}
        alt="Mara Olivares, dietista-nutricionista"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="split-section">
    <div class="container split-section__inner scroll-reveal">
      <h2 class="split-section__label" {...edit("forma_etiqueta")}>{text(data.forma_etiqueta)}</h2>
      <div class="split-section__body">
        <p class="split-section__statement" {...edit("forma_destacado")} set:html={rich(data.forma_destacado)} />
        <div class="text-columns" {...edit("forma_texto")}>
          {paragraphs(data.forma_texto).map((paragraph) => <p set:html={rich(paragraph)} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="split-section split-section--cream" id="formacion">
    <div class="container split-section__inner scroll-reveal">
      <h2 class="split-section__label" {...edit("formacion_etiqueta")}>{text(data.formacion_etiqueta)}</h2>
      <div class="split-section__body">
        <div class="training-grid">
          <div>
            <h3 {...edit("formacion_academica_titulo")}>{text(data.formacion_academica_titulo)}</h3>
            <ul class="ruled-list" {...edit("formacion_academica")}>
              {lines(data.formacion_academica).map((item) => <li set:html={rich(item)} />)}
            </ul>
          </div>
          <div>
            <h3 {...edit("formacion_complementaria_titulo")}>{text(data.formacion_complementaria_titulo)}</h3>
            <ul class="ruled-list" {...edit("formacion_complementaria")}>
              {lines(data.formacion_complementaria).map((item) => <li set:html={rich(item)} />)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="quote-block">
    <div class="container quote-block__inner scroll-reveal">
      <p class="page-label" {...edit("filosofia_etiqueta")}>{text(data.filosofia_etiqueta)}</p>
      <h2 {...edit("filosofia_titulo")} set:html={rich(data.filosofia_titulo)} />
      <div class="text-columns" {...edit("filosofia_texto")}>
        {paragraphs(data.filosofia_texto).map((paragraph) => <p set:html={rich(paragraph)} />)}
      </div>
    </div>
  </section>

  <PageCta spaced page={page} secondaryHref="/como-trabajo" />
</BaseLayout>
