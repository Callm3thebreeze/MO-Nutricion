---
import PageCta from "../components/ui/PageCta.astro";
import PageHero from "../components/ui/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPage, items, plain, rich, text } from "../cms/content";
import "../styles/components/pages.css";

const page = await getPage("pagina_faq", "preguntas-frecuentes");
const { data, edit } = page;
const faqs = items<{ pregunta?: string; respuesta?: string }>(data.preguntas);
---

<BaseLayout
  title={plain(data.meta_titulo)}
  description={plain(data.meta_descripcion)}
  canonicalPath="/preguntas-frecuentes"
  mainClass="pages-main"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: plain(faq.pregunta),
      acceptedAnswer: { '@type': 'Answer', text: plain(faq.respuesta) },
    })),
  }).replace(/</g, '\\u003c')} />

  <PageHero>
    <p class="page-label" {...edit("hero_etiqueta")}>{text(data.hero_etiqueta)}</p>
    <h1 class="page-title" {...edit("hero_titulo")} set:html={rich(data.hero_titulo)} />
    <p class="page-hero__lead" {...edit("hero_subtitulo")} set:html={rich(data.hero_subtitulo)} />
    <a class="link-arrow" href="/contacto">
      <span {...edit("hero_enlace")}>{text(data.hero_enlace)}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>
  </PageHero>

  <section class="split-section">
    <div class="container split-section__inner">
      <h2 class="split-section__label" {...edit("lista_titulo")}>{text(data.lista_titulo)}</h2>
      <div class="split-section__body">
        <div class="faq-list scroll-reveal" {...edit("preguntas")}>
          {
            faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{text(faq.pregunta)}</summary>
                <p set:html={rich(faq.respuesta)} />
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <PageCta page={page} secondaryHref="/consultas" />
</BaseLayout>
