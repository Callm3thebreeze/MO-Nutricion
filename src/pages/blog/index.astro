---
import BlogList from "../../components/blog/BlogList.astro";
import { getPosts } from "../../lib/emdash";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/components/blog.css";

const posts = await getPosts();
---

<BaseLayout
  title="Blog de nutrición"
  description="Artículos sobre salud hormonal, microbiota, salud digestiva y salud metabólica, con rigor científico."
  canonicalPath="/blog"
>
  <section class="blog-index">
    <div class="container">
      <header class="blog-index__header scroll-reveal">
        <p class="page-label">Recursos y consejos</p>
        <div class="heading-row">
          <h1 class="page-title">Blog de <span class="serif-accent">nutrición</span></h1>
          <p class="heading-row__text">
            Artículos para entender tus síntomas y cuidar tu salud hormonal,
            digestiva y metabólica con criterio y sin ruido.
          </p>
        </div>
      </header>
      <BlogList posts={posts} />
    </div>
  </section>
</BaseLayout>
