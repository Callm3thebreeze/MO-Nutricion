---
import { PortableText } from 'astro-portabletext';

import defaultCoverImage from '../../assets/logo/alt-logo.png';
import BlogMeta from '../../components/blog/BlogMeta.astro';
import { getPostBySlug } from '../../lib/emdash';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/components/blog.css';

const slug = Astro.params.slug?.trim() ?? '';
const post = slug.length > 0 ? await getPostBySlug(slug) : null;

if (!post) {
	Astro.response.status = 404;
}

const postPath = post ? `/blog/${post.slug}` : '/blog';
const usesDefaultCover = post?.coverImage.src.startsWith('/assets/logo/') ?? false;
const coverImageSrc = usesDefaultCover
	? defaultCoverImage.src
	: post?.coverImage.src;
---

<BaseLayout
	title={post ? post.seoTitle ?? post.title : 'Artículo no encontrado'}
	description={
		post
			? post.seoDescription ?? post.excerpt
			: 'El artículo que buscas no está disponible o ya no está publicado.'
	}
	canonicalPath={postPath}
	canonicalUrl={post?.canonicalUrl}
	type={post ? 'article' : 'website'}
	noindex={!post}
>
	{
		post && (
			<script slot="head" type="application/ld+json" is:inline>
				{JSON.stringify({
					'@context': 'https://schema.org',
					'@type': 'BlogPosting',
					headline: post.title,
					description: post.excerpt,
					datePublished: post.publishedAt,
					dateModified: post.updatedAt ?? post.publishedAt,
					url: post.canonicalUrl ?? `https://maraolivaresnutricio.com${postPath}`,
					image: coverImageSrc?.startsWith('http')
						? coverImageSrc
						: `https://maraolivaresnutricio.com${coverImageSrc}`,
					publisher: {
						'@type': 'Organization',
						name: 'Mara Olivares Nutrición Integrativa',
					},
				})}
			</script>
		)
	}

	{
		post ? (
			<section class="article-section">
				<div class="container article-layout">
					<article>
						<header class="article-header scroll-reveal">
							<a class="link-arrow link-arrow--back article-back" href="/blog">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
								Volver al blog
							</a>
							<BlogMeta publishedAt={post.publishedAt} category={post.category} tags={post.tags} />
							<h1 class="page-title">{post.title}</h1>
							<p class="article-excerpt">{post.excerpt}</p>
							<img
								src={coverImageSrc}
								alt={post.coverImage.alt}
								class={`article-header__image ${usesDefaultCover ? 'article-header__image--brand' : ''}`}
								width="661"
								height="368"
								loading="lazy"
								decoding="async"
							/>
						</header>

						<div class="article-content scroll-reveal" style="--home-reveal-delay: 90ms">
							<PortableText value={post.content} />
						</div>

						<footer class="article-footer scroll-reveal">
							<div class="cta-panel cta-panel--compact">
								<h2>¿Quieres una estrategia <span class="serif-accent">adaptada a ti?</span></h2>
								<p>Valoramos tu caso en una primera consulta de 90 minutos, online o presencial en Albacete.</p>
								<a class="button" href="/contacto">Agenda tu primera consulta</a>
							</div>
						</footer>
					</article>
				</div>
			</section>
		) : (
			<section class="not-found-section">
				<div class="container not-found">
					<p class="page-label">Error 404</p>
					<h1 class="page-title">Artículo no <span class="serif-accent">encontrado</span></h1>
					<p>El contenido que buscas no está disponible o ya no está publicado.</p>
					<a class="button" href="/blog">Volver al blog</a>
				</div>
			</section>
		)
	}
</BaseLayout>
