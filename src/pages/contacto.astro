---
import ContactForm from '../components/contact/ContactForm.astro';
import PageHero from '../components/ui/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, plain, rich, text } from '../cms/content';
import '../styles/components/contact.css';
import '../styles/components/pages.css';

const page = await getPage('pagina_contacto', 'contacto');
const { data, edit } = page;
---

<BaseLayout
title={plain(data.meta_titulo)}
description={plain(data.meta_descripcion)}
canonicalPath="/contacto"
mainClass="contact-main"
>
<PageHero>
<p class="page-label" {...edit('hero_etiqueta')}>{text(data.hero_etiqueta)}</p>
<h1 class="page-title" {...edit('hero_titulo')} set:html={rich(data.hero_titulo)} />
<p class="page-hero__lead" {...edit('hero_subtitulo')} set:html={rich(data.hero_subtitulo)} />
<p class="page-hero__text" {...edit('hero_texto')} set:html={rich(data.hero_texto)} />
</PageHero>
<ContactForm page={page} />
</BaseLayout>
