---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
title="Página no encontrada"
description="La página que buscas no está disponible."
canonicalPath="/404"
noindex={true}
>
<section class="not-found-section">
<div class="container not-found">
<p class="page-label">Error 404</p>
<h1 class="page-title">Esta página <span class="serif-accent">no existe</span></h1>
<p>La dirección que has visitado no existe o ha cambiado.</p>
<a class="button" href="/">Volver al inicio</a>
</div>
</section>
</BaseLayout>
