---
import Footer from "../components/ui/Footer.astro";
import Header from "../components/ui/Header.astro";
import SeoHead from "../components/ui/SeoHead.astro";
import SkipLink from "../components/ui/SkipLink.astro";

import "../styles/reset.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/utilities.css";
import "../styles/components/layout.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  canonicalUrl?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  mainClass?: string;
}

const { mainClass, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead {...seoProps} />
    <slot name="head" />
    <script is:inline>
      // Oculta los elementos animados antes del primer pintado; si GSAP no llega a cargar, se muestran igualmente
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js-motion");
        window.setTimeout(() => {
          if (!document.documentElement.classList.contains("motion-ready")) {
            document.documentElement.classList.remove("js-motion");
          }
        }, 3000);
      }
    </script>
  </head>
  <body>
    <SkipLink />
    <Header />
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main id="main-content" class={mainClass}>
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
