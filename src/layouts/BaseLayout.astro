---
import Footer from "../components/ui/Footer.astro";
import Header from "../components/ui/Header.astro";
import SeoHead from "../components/ui/SeoHead.astro";
import SkipLink from "../components/ui/SkipLink.astro";
import mainLogo from "../assets/logo/main-logo.png";
import { siteGraph } from "../lib/schema";

import "../styles/reset.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/utilities.css";
import "../styles/components/layout.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  canonicalUrl?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  mainClass?: string;
}

const { mainClass, ...seoProps } = Astro.props;
import parkinsansLatin from "../assets/fonts/parkinsans-latin.woff2?url";
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead {...seoProps} />
    <!-- la fuente del texto se pide en paralelo al CSS en vez de esperar a leerlo -->
    <link rel="preload" href={parkinsansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteGraph(Astro.site, mainLogo.src))} />
    <slot name="head" />
    <script is:inline src="/motion-init.js"></script>
  </head>
  <body>
    <SkipLink />
    <Header />
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main id="main-content" class={mainClass}>
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
